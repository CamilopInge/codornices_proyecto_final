# Copy to .env and set strong, private values before starting Compose.
NODE_ENV=production
API_PORT=3000
API_HOST=0.0.0.0
APP_URL=http://localhost:3000
DATA_DIR=/app/data
JWT_SECRET=
SEED_ADMIN_NOMBRE=Administrador
SEED_ADMIN_USERNAME=administrador
SEED_ADMIN_EMAIL=administrador@evalcodorniz.edu.co
SEED_ADMIN_PASSWORD=

# Optional integrations
FRONTEND_ORIGIN=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=administrador@evalcodorniz.edu.co
MAIL_FROM_NAME=EvalCodorniz ICA
OPENAI_API_KEY=
OPENAI_API_BASE=
AI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_TOKENS=1024
ASISTENTE_LIMITE_HORA=60
ASISTENTE_TURNOS_HISTORIAL=6
